# URL del servidor SSO de Greenborn
URL_AUTH_SERVICE=https://auth.greenborn.com.ar

# Mapeo de roles SSO (JSON): {"email": role_id, "*@dominio": role_id}
# 1=Administrador, 2=Delegado, 3=Concursante
SSO_ROLE_MAP={"admin@greenborn.com.ar":1,"*@delegados.greenborn.com.ar":2}

# Base de datos (ejemplo con Knex)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sso_demo
DB_USER=postgres
DB_PASSWORD=postgres

# Puerto de la demo (por convención del proyecto, 5175)
SERVICE_PORT=5175

# WebSocket complementario (socket.io)
# Ruta del socket (default: /socket.io)
SOCKET_PATH=/socket.io
# Origen(es) CORS permitidos (default: *)
SOCKET_CORS=*

