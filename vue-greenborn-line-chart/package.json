{
  "name": "vue-greenborn-line-chart",
  "version": "1.0.0",
  "description": "Gráfico de líneas en SVG para Vue 3, sin librerías de gráficos de terceros: dibuja una o varias series con leyenda, grilla, tooltips por punto y marcas en el eje X. Pensado para paneles de métricas/estadísticas simples (porcentajes, conteos, etc).",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-greenborn-line-chart.umd.cjs",
  "module": "./dist/vue-greenborn-line-chart.js",
  "exports": {
    ".": {
      "import": "./dist/vue-greenborn-line-chart.js",
      "require": "./dist/vue-greenborn-line-chart.umd.cjs"
    },
    "./style.css": "./dist/vue-greenborn-line-chart.css",
    "./dist/style.css": "./dist/vue-greenborn-line-chart.css"
  },
  "style": "./dist/vue-greenborn-line-chart.css",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "preview": "vite preview"
  },
  "keywords": [
    "vue",
    "vue3",
    "chart",
    "line-chart",
    "svg",
    "grafico",
    "estadisticas",
    "greenborn"
  ],
  "license": "MIT",
  "author": {
    "name": "2012lucho",
    "email": "lucho.2012.tandil@gmail.com"
  },
  "homepage": "https://github.com/Greenborn/opencode_dev/tree/main/vue-greenborn-line-chart",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greenborn/opencode_dev.git"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.2.0",
    "vue": "^3.4.0"
  }
}
