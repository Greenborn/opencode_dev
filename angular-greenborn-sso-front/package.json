{
  "name": "angular-greenborn-sso-front",
  "version": "1.0.0",
  "description": "Cliente SSO (Single Sign-On) para aplicaciones Angular 21. Integra login con Google (OAuth), intercambio de token temporal por bearer token, verificación de sesión, logout, renovación de token (X-New-Token), guard de rutas y WebSocket complementario (socket.io). Compatible con express-greenborn-sso-back.",
  "keywords": [
    "angular",
    "angular21",
    "sso",
    "oauth",
    "google",
    "auth",
    "authentication",
    "greenborn",
    "socket.io"
  ],
  "license": "MIT",
  "author": {
    "name": "2012lucho",
    "email": "lucho.2012.tandil@gmail.com"
  },
  "homepage": "https://github.com/Greenborn/opencode_dev/tree/main/angular-greenborn-sso-front",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greenborn/opencode_dev.git"
  },
  "main": "dist/fesm2022/angular-greenborn-sso-front.mjs",
  "module": "dist/fesm2022/angular-greenborn-sso-front.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fesm2022/angular-greenborn-sso-front.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "ng build",
    "prepublishOnly": "ng build",
    "prepack": "ng build",
    "demo": "ng serve demo --port 5175 --open"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "^7.5.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "^1.18.1",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/compiler-cli": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-browser-dynamic": "^21.2.18",
    "@angular/router": "^21.2.18",
    "bootstrap": "^5.3.3",
    "ng-packagr": "^21.2.19",
    "rxjs": "^7.5.0",
    "typescript": "~5.9.3",
    "zone.js": "~0.15.0"
  }
}
