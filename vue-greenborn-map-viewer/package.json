{
  "name": "vue-greenborn-map-viewer",
  "version": "1.0.0",
  "description": "Visor de mapa (Leaflet) con múltiples puntos para Vue 3, ideal para mostrar ubicaciones de profesionales, servicios o recursos.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-greenborn-map-viewer.umd.cjs",
  "module": "./dist/vue-greenborn-map-viewer.js",
  "exports": {
    ".": {
      "import": "./dist/vue-greenborn-map-viewer.js",
      "require": "./dist/vue-greenborn-map-viewer.umd.cjs"
    },
    "./style.css": "./dist/vue-greenborn-map-viewer.css",
    "./dist/style.css": "./dist/vue-greenborn-map-viewer.css"
  },
  "style": "./dist/vue-greenborn-map-viewer.css",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "preview": "vite preview"
  },
  "keywords": [
    "vue",
    "vue3",
    "leaflet",
    "map",
    "map-viewer",
    "multiple-points",
    "location",
    "greenborn"
  ],
  "license": "MIT",
  "author": {
    "name": "2012lucho",
    "email": "lucho.2012.tandil@gmail.com"
  },
  "homepage": "https://github.com/Greenborn/opencode_dev/tree/main/vue-greenborn-map-viewer",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greenborn/opencode_dev.git"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.2.0",
    "vue": "^3.4.0"
  }
}
