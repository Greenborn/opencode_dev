{
  "name": "@greenborn/vue-greenborn-notificaciones",
  "version": "0.1.0",
  "description": "Cliente Web Push (VAPID) reutilizable para proyectos Vue 3 / PWA: suscripción/desuscripción desde el front y un módulo (`/sw`) para registrar los listeners `push`/`notificationclick` dentro del service worker propio del proyecto (vite-plugin-pwa injectManifest).",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-greenborn-notificaciones.cjs",
  "module": "./dist/vue-greenborn-notificaciones.js",
  "exports": {
    ".": {
      "import": "./dist/vue-greenborn-notificaciones.js",
      "require": "./dist/vue-greenborn-notificaciones.cjs"
    },
    "./sw": {
      "import": "./dist/sw.js",
      "require": "./dist/sw.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "prepublishOnly": "npm run build",
    "preview": "vite preview"
  },
  "keywords": [
    "vue",
    "vue3",
    "push",
    "web-push",
    "vapid",
    "pwa",
    "notifications",
    "greenborn"
  ],
  "license": "MIT",
  "author": {
    "name": "2012lucho",
    "email": "lucho.2012.tandil@gmail.com"
  },
  "homepage": "https://github.com/Greenborn/opencode_dev/tree/main/vue-greenborn-notificaciones",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greenborn/opencode_dev.git"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.2.0",
    "vue": "^3.4.0"
  }
}
