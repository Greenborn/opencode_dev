# Configuración de la galería (el demo y el paquete las leen al arrancar)
GALERIA_UPLOAD_DIR=uploads/galeria
# Base pública para construir las URLs de los archivos (ej: https://midominio.com)
GALERIA_PUBLIC_BASE_URL=
GALERIA_MAX_FILE_SIZE=10485760
GALERIA_THUMBNAIL_WIDTH=400
GALERIA_DEFAULT_LIMIT=24
GALERIA_MAX_LIMIT=100

# Conexión a la BD del host (el paquete inyecta la instancia de knex; el demo
# la construye con estas variables)
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Puerto del demo (todas las demos Greenborn usan 5175)
SERVICE_PORT=5175
