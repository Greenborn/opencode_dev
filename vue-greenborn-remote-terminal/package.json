{
  "name": "vue-greenborn-remote-terminal",
  "version": "1.0.2",
  "description": "Terminal remota xterm.js transport-agnostic para Vue 3: render completo (colores ANSI, cursor, scrollback, redimensionado con FitAddon, pantalla completa, menú contextual copiar, toolbar). Emite input/resize/close y expone write/writeExit; el transporte (socket.io, WebSocket, etc.) lo implementa el consumidor.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-greenborn-remote-terminal.umd.cjs",
  "module": "./dist/vue-greenborn-remote-terminal.js",
  "exports": {
    ".": {
      "import": "./dist/vue-greenborn-remote-terminal.js",
      "require": "./dist/vue-greenborn-remote-terminal.umd.cjs"
    },
    "./style.css": "./dist/vue-greenborn-remote-terminal.css",
    "./dist/style.css": "./dist/vue-greenborn-remote-terminal.css"
  },
  "style": "./dist/vue-greenborn-remote-terminal.css",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "preview": "vite preview"
  },
  "keywords": [
    "vue",
    "vue3",
    "terminal",
    "xterm",
    "remote-terminal",
    "pty",
    "websocket",
    "socketio"
  ],
  "license": "MIT",
  "author": {
    "name": "2012lucho",
    "email": "lucho.2012.tandil@gmail.com"
  },
  "homepage": "https://github.com/Greenborn/opencode_dev/tree/main/vue-greenborn-remote-terminal",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greenborn/opencode_dev.git"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "vite": "^5.2.0",
    "vue": "^3.4.0"
  }
}
