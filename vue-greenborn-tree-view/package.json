{
  "name": "vue-greenborn-tree-view",
  "version": "1.0.0",
  "description": "Vista de árbol genérica para Vue 3 con carga diferida (lazy-load): trae primero los nodos raíz y, al expandir cada nodo, pide sus hijos mediante una función `cargarNodos(nodoPadre)` que provee el consumidor. No asume ningún backend ni forma de dato en particular. Slots `nodo` y `toggle` para personalizar contenido e ícono de expansión. Sin dependencias de UI (CSS propio) y sin dependencias runtime.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-greenborn-tree-view.umd.cjs",
  "module": "./dist/vue-greenborn-tree-view.js",
  "exports": {
    ".": {
      "import": "./dist/vue-greenborn-tree-view.js",
      "require": "./dist/vue-greenborn-tree-view.umd.cjs"
    },
    "./style.css": "./dist/vue-greenborn-tree-view.css",
    "./dist/style.css": "./dist/vue-greenborn-tree-view.css"
  },
  "style": "./dist/vue-greenborn-tree-view.css",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "preview": "vite preview"
  },
  "keywords": [
    "vue",
    "vue3",
    "tree",
    "tree-view",
    "arbol",
    "lazy-load",
    "lazy-loading",
    "greenborn"
  ],
  "license": "MIT",
  "author": {
    "name": "2012lucho",
    "email": "lucho.2012.tandil@gmail.com"
  },
  "homepage": "https://github.com/Greenborn/opencode_dev/tree/main/vue-greenborn-tree-view",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greenborn/opencode_dev.git"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.2.0",
    "vue": "^3.4.0"
  }
}
