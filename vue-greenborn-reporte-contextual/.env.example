# Copiar a .env (no versionar .env).
# Base de la API del SGI para pruebas locales. No apuntar a producción desde la demo.
VITE_SGI_API_URL=
# Token de un usuario del SGI con permiso proyectos.ver (solo para listar proyectos).
VITE_SGI_TOKEN=
# Versión precompletada en el reporte (opcional).
VITE_REPORTE_VERSION=
